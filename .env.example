# Resend API key from the Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxx

# Default sender used when the in-app From field is blank.
# The domain must be verified with the email provider.
SCOPELOGIC_DEFAULT_FROM_EMAIL=ScopeLogic LLC <deliverables@your-verified-domain.com>

# Optional server-side supplemental sender list. The editable in-app approved list is also sent to the API.
# The email provider still requires each sender domain to be verified.
SCOPELOGIC_ALLOWED_FROM_EMAILS=deliverables@your-verified-domain.com,estimating@your-verified-domain.com

# Optional default Reply-To address.
SCOPELOGIC_DEFAULT_REPLY_TO=yourname@your-domain.com

# Supabase production connection (browser-safe values from the Supabase Connect dialog).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
