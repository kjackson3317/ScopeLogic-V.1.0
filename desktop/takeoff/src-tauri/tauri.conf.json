{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScopeLogic Takeoff",
  "version": "0.1.0",
  "identifier": "com.scopelogic.takeoff",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScopeLogic Takeoff",
        "width": 1600,
        "height": 1000,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": false
  }
}
